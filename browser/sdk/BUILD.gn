import("//third_party/webrtc/webrtc.gni")

sdk_headers = [
  "../../sdk/include/remotekit_sdk.h",
  "../../sdk/include/remotekit_rtc.h",
]

sdk_sources = [
  "sdk_control.cc",
  "sdk_internal.h",
  "sdk_render.cc",
  "sdk_resources.cc",
  "sdk_resources.h",
  "sdk_runtime.cc",
]
rtc_sources = [
  "rtc_audio.cc",
  "rtc_audio_source.h",
  "rtc_encoder.cc",
  "rtc_internal.h",
  "rtc_peer.cc",
  "rtc_silent_audio.h",
  "rtc_stats.cc",
  "rtc_trace.h",
  "rtc_video_source.cc",
]

shared_library("remotekit_sdk") {
  configs -= [ "//build/config/clang:find_bad_constructs" ]
  output_name = "remotekit_sdk"
  sources = [
              "../osr_wake_state.h",
              "render_generation_state_probe.cc",
              "render_slots_abi_probe.cc",
            ] + sdk_headers + sdk_sources + rtc_sources
  include_dirs = [ "//remotekit" ]
  defines = [ "REMOTEKIT_SDK_IMPLEMENTATION" ]
  libs = [ "ws2_32.lib" ]

  # Consume Chromium's exported WebRTC component. This DLL only exports C ABI.
  deps = [
    "//base",
    "//mojo/core/embedder",
    "//mojo/public/cpp/platform",
    "//mojo/public/cpp/system",
    "//third_party/webrtc_overrides:webrtc_component",
    "//ui/events",
    "//ui/events:dom_keycode_converter",
  ]
  write_runtime_deps = "$root_out_dir/remotekit_sdk.runtime_deps"
}

# CPU-only regression probe calls the production implementation with real local
# Mojo pipes; it does not start Chromium ContentMain or require GPU hardware.
executable("remotekit_sdk_control_lifetime_probe") {
  testonly = true
  configs -= [ "//build/config/clang:find_bad_constructs" ]
  sources = [ "control_channel_lifetime_probe.cc" ] + sdk_headers + sdk_sources
  defines = [ "REMOTEKIT_SDK_IMPLEMENTATION" ]
  deps = [
    "//base",
    "//mojo/core/embedder",
    "//mojo/public/cpp/platform",
    "//mojo/public/cpp/system",
    "//third_party/webrtc_overrides:webrtc_component",
    "//ui/events",
    "//ui/events:dom_keycode_converter",
  ]
}

# Runs production AdaptFrame/native-source ownership and real RTP sender policy
# without a renderer, negotiated media transport, or hardware encoder.
executable("remotekit_rtc_adaptation_probe") {
  testonly = true
  configs -= [ "//build/config/clang:find_bad_constructs" ]
  sources = [ "rtc_adaptation_probe.cc" ] + sdk_headers + rtc_sources
  defines = [ "REMOTEKIT_SDK_IMPLEMENTATION" ]
  libs = [ "ws2_32.lib" ]
  deps = [
    "//base",
    "//third_party/webrtc_overrides:webrtc_component",
  ]
}

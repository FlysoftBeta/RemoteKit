import("//tools/grit/repack.gni")

source_set("endpoint_model") {
  # This portable library also builds with MSVC outside Chromium.
  configs -= [ "//build/config/clang:find_bad_constructs" ]
  sources = [ "//remotekit/endpoint/src/core.cpp" ]
  include_dirs = [ "//remotekit/endpoint/include" ]
}

template("browser_executable") {
 executable(target_name) {
  if (invoker.demo) {
    defines = [ "REMOTEKIT_DEMO_HARNESS=1" ]
  }
  configs -= [ "//build/config/clang:find_bad_constructs" ]
  configs -= [ "//build/config/win:console" ]
  configs += [ "//build/config/win:windowed" ]
  sources = [
    "//chrome/renderer/loadtimes_bindings.cc",
    "audio_target.cc",
    "audio_target.h",
    "//chrome/renderer/loadtimes_bindings.h",
    "browser_context.cc",
    "browser_context.h",
    "compat.cc",
    "compat.h",
    "compat_renderer.cc",
    "compat_renderer.h",
    "client_gesture_bridge.cc",
    "client_gesture_bridge.h",
    "client_gesture_packet.cc",
    "client_gesture_packet.h",
    "client_input_timing.h",
    "client_touch_retirement.h",
    "control_server.cc",
    "control_server.h",
    "control_response.cc",
    "control_response.h",
    "file_chooser_accept.cc",
    "file_chooser_accept.h",
    "devtools.cc",
    "devtools.h",
    "osr_renderer.cc",
    "osr_renderer.h",
    "osr_wake_state.h",
    "render_channel.cc",
    "render_channel.h",
    "harness.cc",
    "harness.h",
    "main.cc",
    "main_delegate.cc",
    "main_delegate.h",
    "navigation_error_page.h",
    "navigation_state.cc",
    "navigation_state.h",
    "navigation_operations.h",
    "offscreen_host.cc",
    "offscreen_host.h",
    "page_requests.cc",
    "page_requests.h",
    "profile_services.cc",
    "profile_services.h",
    "profile_network_state.cc",
    "profile_network_state.h",
    "webview.cc",
    "webview.h",
  ]
  include_dirs = [
    "//remotekit",
    "//remotekit/endpoint/include",
  ]
  deps = [
    ":endpoint_model",
    ":pak",
    "//base",
    "//build/win:default_exe_manifest",
    "//components/download/public/common:public",
    "//components/embedder_support:user_agent",
    "//components/headless/clipboard",
    "//components/os_crypt/async/browser",
    "//components/os_crypt/async/browser:dpapi_key_provider",
    "//components/prefs",
    "//components/input",
    "//components/services/quarantine",
    "//components/services/quarantine/public/mojom",
    "//components/sessions",
    "//components/version_info",
    "//components/viz/common",
    "//components/viz/host",
    "//content:sandbox_helper_win",
    "//content/public/app",
    "//content/public/browser",
    "//content/public/common",
    "//content/public/renderer",
    "//gin",
    "//media",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/platform",
    "//mojo/public/cpp/system",
    "//net",
    "//sandbox",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//services/viz/privileged/mojom/compositing",
    "//third_party/blink/public:blink",
    "//ui/aura",
    "//ui/compositor",
    "//ui/base",
    "//ui/base/ime",
    "//ui/display",
    "//ui/gfx",
    "//ui/events/platform",
    "//ui/events/blink",
    "//ui/events:gesture_detection",
    "//ui/views",
    "//ui/views/controls/webview",
    "//ui/wm",
    "//url",
    "//v8",
  ]
  data_deps = [ "//tools/v8_context_snapshot" ]
  libs = [
    "d3d11.lib",
    "d3dcompiler.lib",
    "dxgi.lib",
  ]
}

}

browser_executable("remotekit_browser") {
  demo = false
}
browser_executable("remotekit_browser_demo") {
  demo = true
}

executable("remotekit_control_payload_probe") {
  testonly = true
  sources = [ "control_payload_probe.cc", "control_response.cc", "file_chooser_accept.cc" ]
  include_dirs = [ "//remotekit" ]
  deps = [ "//base", "//net" ]
}

executable("remotekit_begin_frame_probe") {
  testonly = true
  sources = [ "begin_frame_probe.cc" ]
  deps = [
    "//base",
    "//components/viz/common",
    "//components/viz/service",
    "//gpu/command_buffer/service",
    "//mojo/core/embedder",
    "//services/viz/privileged/mojom/compositing",
  ]
}

executable("remotekit_profile_isolation_probe") {
  testonly = true
  sources = [
    "profile_isolation_probe.cc",
    "profile_network_state.cc",
    "profile_network_state.h",
  ]
  include_dirs = [ "//remotekit" ]
  deps = [
    "//base",
    "//components/headless/clipboard",
    "//components/os_crypt/async/browser",
    "//components/os_crypt/async/browser:dpapi_key_provider",
    "//components/prefs",
    "//mojo/core/embedder",
    "//mojo/public/cpp/bindings",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//ui/base/clipboard",
  ]
}

executable("remotekit_scroll_handoff_probe") {
  testonly = true
  defines = [ "INSIDE_BLINK" ]
  sources = [ "scroll_handoff_probe.cc" ]
  include_dirs = [ "//remotekit" ]
  deps = [ "//base", "//cc", "//third_party/blink/public:blink" ]
}

executable("remotekit_client_gesture_probe") {
  testonly = true
  # Includes the portable Endpoint model, like the production embedder.
  configs -= [ "//build/config/clang:find_bad_constructs" ]
  sources = [ "client_gesture_probe.cc", "client_gesture_packet.cc", "client_gesture_packet.h", "client_input_timing.h", "client_touch_retirement.h" ]
  include_dirs = [ "//remotekit", "//remotekit/endpoint/include" ]
  deps = [
    "//base",
    "//components/input",
    "//third_party/blink/public:blink",
    "//ui/events:gesture_detection",
    "//ui/events:velocity_tracker",
    "//ui/events/blink",
  ]
}

repack("pak") {
  sources = [
    "$root_gen_dir/content/content_resources.pak",
    "$root_gen_dir/content/gpu_resources.pak",
    "$root_gen_dir/content/process_resources.pak",
    "$root_gen_dir/net/net_resources.pak",
    "$root_gen_dir/third_party/blink/public/resources/blink_resources.pak",
    "$root_gen_dir/third_party/blink/public/resources/blink_scaled_resources_100_percent.pak",
    "$root_gen_dir/third_party/blink/public/resources/inspector_overlay_resources.pak",
    "$root_gen_dir/third_party/blink/public/strings/blink_strings_en-US.pak",
    "$root_gen_dir/ui/resources/ui_resources_100_percent.pak",
    "$root_gen_dir/ui/strings/app_locale_settings_en-US.pak",
    "$root_gen_dir/ui/strings/ax_strings_en-US.pak",
    "$root_gen_dir/ui/strings/ui_strings_en-US.pak",
    "$root_gen_dir/ui/views/resources/views_resources_100_percent.pak",
  ]
  deps = [
    "//content:content_resources",
    "//content/browser/resources/gpu:resources",
    "//content/browser/resources/process:resources",
    "//net:net_resources",
    "//third_party/blink/public:devtools_inspector_resources",
    "//third_party/blink/public:resources",
    "//third_party/blink/public:scaled_resources_100_percent",
    "//third_party/blink/public/strings",
    "//ui/resources",
    "//ui/strings",
    "//ui/views/resources",
  ]
  output = "$root_out_dir/remotekit.pak"
}

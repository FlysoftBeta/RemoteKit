file(GLOB_RECURSE sources "${MEDIA_ROOT}/*.hpp" "${MEDIA_ROOT}/*.cpp" "${MEDIA_ROOT}/*.h")
foreach(source IN LISTS sources)
  file(READ "${source}" content)
  if(content MATCHES "RuntimeOptions")
    message(FATAL_ERROR "Media layer depends on RuntimeOptions: ${source}")
  endif()
  string(REGEX MATCHALL "#[ \t]*include[ \t]*[\"<][^\">]+[\">]" includes "${content}")
  foreach(include IN LISTS includes)
    string(REGEX REPLACE "^.*[\"<]([^\">]+)[\">]$" "\\1" header "${include}")
    if(header MATCHES "(^|/)(session|rtc|diagnostics|objects|persistence|management|cluster)/" OR
       header MATCHES "(^|/)options\\.hpp$")
      message(FATAL_ERROR "Forbidden media include in ${source}: ${header}")
    endif()
    get_filename_component(local "${source}" DIRECTORY)
    if(EXISTS "${local}/${header}")
      file(REAL_PATH "${local}/${header}" resolved)
    elseif(EXISTS "${SOURCE_ROOT}/${header}")
      file(REAL_PATH "${SOURCE_ROOT}/${header}" resolved)
    else()
      continue()
    endif()
    file(RELATIVE_PATH relative "${SOURCE_ROOT}" "${resolved}")
    if(NOT relative MATCHES "^(media|platform|util)/" AND NOT relative MATCHES "^\\.\\./\\.\\./protocol/")
      message(FATAL_ERROR "Forbidden media dependency in ${source}: ${header}")
    endif()
  endforeach()
endforeach()
message(STATUS "Media layer includes verified")

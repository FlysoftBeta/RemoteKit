 // Any time a touch start event is handled/consumed/default prevented it is
 // removed from the gesture map, because it will never create a gesture.
+bool RenderWidgetHostInputEventRouter::RegisterClientTouch(
+    RenderWidgetHostViewInput* root, uint32_t id, ClientTouchAck callback) {
+  if (!root || !id || client_touch_acks_.size() >= 512) return false;
+  return client_touch_acks_.emplace(
+      id, ClientTouchRegistration{root->GetInputWeakPtr(), std::move(callback)}).second;
+}
+
+void RenderWidgetHostInputEventRouter::WithdrawUnroutedClientTouch(
+    RenderWidgetHostViewInput* root, uint32_t id) {
+  auto it = client_touch_acks_.find(id);
+  if (it != client_touch_acks_.end() && it->second.root.get() == root)
+    client_touch_acks_.erase(it);
+}
+
+bool RenderWidgetHostInputEventRouter::AckClientTouch(
+    RenderWidgetHostViewInput* root, const blink::WebTouchEvent& event,
+    blink::mojom::InputEventResultState result, RenderWidgetHostViewInput* target) {
+  auto it = client_touch_acks_.find(event.unique_touch_event_id);
+  if (it == client_touch_acks_.end()) return false;
+  // A null root is valid after destruction; the registered ID is still ours.
+  if (root && it->second.root.get() != root) return false;
+  auto callback = std::move(it->second.callback);
+  client_touch_acks_.erase(it);
+  std::move(callback).Run(event, result, target);
+  return true;
+}
+
+bool RenderWidgetHostInputEventRouter::RouteClientGestureEvent(
+    RenderWidgetHostViewInput* root, const blink::WebGestureEvent& event,
+    uint32_t owner_id, RenderWidgetHostViewInput* expected_target) {
+  if (!root || !IsViewInMap(root)) return false;
+  if (event.GetType() == blink::WebInputEvent::Type::kGestureTapDown) {
+    auto it = touchscreen_gesture_target_map_.find(event.unique_touch_event_id);
+    if (it == touchscreen_gesture_target_map_.end() || it->second.get() != expected_target) return false;
+    client_gesture_owner_id_ = owner_id;
+  } else if (client_gesture_owner_id_ != owner_id ||
+             touchscreen_gesture_target_.get() != expected_target) {
+    return false;
+  }
+  RouteGestureEvent(root, &event, ui::LatencyInfo());
+  return true;
+}

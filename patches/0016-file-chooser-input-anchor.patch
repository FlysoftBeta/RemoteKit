+
+void FileChooser::PublishInputAnchor(
+    mojom::blink::FileChooserInputAnchorPtr anchor) {
+  if (!file_chooser_.is_bound() ||
+      (!anchor && !last_input_anchor_) ||
+      (anchor && last_input_anchor_ && anchor->Equals(*last_input_anchor_))) {
+    return;
+  }
+  last_input_anchor_ = anchor.Clone();
+  file_chooser_->UpdateInputAnchor(std::move(anchor));
+}
+
+void FileChooser::StopInputAnchor() {
+  if (input_anchor_observer_) {
+    input_anchor_observer_->Stop();
+    input_anchor_observer_.Clear();
+  }
+}
+
+void FileChooser::DisconnectClient() {
+  PublishInputAnchor(nullptr);
+  StopInputAnchor();
+  input_anchor_element_.Clear();
+  client_ = nullptr;
+}
 

+class FileChooser::InputAnchorObserver final
+    : public GarbageCollected<InputAnchorObserver>,
+      public LocalFrameView::LifecycleNotificationObserver {
+ public:
+  InputAnchorObserver(FileChooser& chooser,
+                      HTMLInputElement& input,
+                      LocalFrameView& view)
+      : chooser_(&chooser), input_(&input), view_(&view) {
+    view.RegisterForLifecycleNotifications(this);
+  }
+
+  void Stop() {
+    chooser_ = nullptr;
+    if (view_)
+      view_->UnregisterFromLifecycleNotifications(this);
+    view_ = nullptr;
+  }
+
+  void Trace(Visitor* visitor) const override {
+    visitor->Trace(input_);
+    visitor->Trace(view_);
+  }
+
+  void WillDisposeView() override {
+    if (chooser_)
+      chooser_->PublishInputAnchor(nullptr);
+    view_ = nullptr;
+  }
+
+  void DidFinishPostLifecycleSteps(const LocalFrameView&) override {
+    if (chooser_)
+      chooser_->PublishInputAnchor(CurrentAnchor());
+  }
+
+ private:
+  mojom::blink::FileChooserInputAnchorPtr CurrentAnchor() const {
+    auto* input = input_.Get();
+    auto* view = view_.Get();
+    if (!input || !view || !input->isConnected() ||
+        input->GetDocument().View() != view ||
+        input->FormControlType() != mojom::blink::FormControlType::kInputFile) {
+      return nullptr;
+    }
+    auto* layout = input->GetLayoutObject();
+    auto& frame = view->GetFrame();
+    auto* widget = frame.GetWidgetForLocalRoot();
+    auto* layout_view = view->GetLayoutView();
+    if (!layout || !widget || !frame.GetPage() || !layout_view ||
+        layout->Style().Visibility() != EVisibility::kVisible ||
+        !layout->HasNonZeroEffectiveOpacity()) {
+      return nullptr;
+    }
+
+    const auto& viewport = frame.GetPage()->GetVisualViewport();
+    const gfx::Rect viewport_pixels(viewport.Size());
+    gfx::Rect bounds = view->FrameToViewport(
+        input->VisibleBoundsRespectingClipsInLocalRoot());
+    bounds.Intersect(viewport_pixels);
+    if (bounds.IsEmpty())
+      return nullptr;
+
+    // Require the center of the visible fragment to resolve to the input
+    // (including the native upload button in its user agent shadow tree).
+    HitTestLocation location(view->RootFrameToDocument(
+        viewport.ViewportToRootFrame(bounds.CenterPoint())));
+    HitTestResult result(
+        HitTestRequest(HitTestRequest::kReadOnly |
+                       HitTestRequest::kIgnoreZeroOpacityObjects),
+        location);
+    if (!layout_view->HitTestNoLifecycleUpdate(location, result) ||
+        !result.InnerNode() ||
+        !input->IsShadowIncludingInclusiveAncestorOf(*result.InnerNode())) {
+      return nullptr;
+    }
+    return mojom::blink::FileChooserInputAnchor::New(
+        widget->BlinkSpaceToDIPs(gfx::RectF(bounds)),
+        widget->BlinkSpaceToDIPs(gfx::RectF(viewport_pixels)).size(),
+        widget->GetOriginalScreenInfo().device_scale_factor);
+  }
+
+  raw_ptr<FileChooser> chooser_;
+  WeakMember<HTMLInputElement> input_;
+  WeakMember<LocalFrameView> view_;
+};

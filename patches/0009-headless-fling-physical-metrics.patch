 gfx::Vector2dF FlingScheduler::GetPixelsPerInch(
     const gfx::PointF& position_in_screen) {
+  // The service embedder has no client physical monitor. Keep logical input
+  // metrics separate from page DPR and native demo monitor characteristics.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "remotekit-service-input")) {
+    return gfx::Vector2dF(input::kDefaultPixelsPerInch,
+                        input::kDefaultPixelsPerInch);
+  }
 #if BUILDFLAG(IS_WIN)
-  return display::win::GetScreenWin()->GetPixelsPerInch(position_in_screen);
+  gfx::Vector2dF pixels_per_inch =
+      display::win::GetScreenWin()->GetPixelsPerInch(position_in_screen);
+  // A headless Screen may have no physical monitor metrics. Physics-based
+  // curves require positive finite PPI on both axes; preserve valid metrics.
+  if (!std::isfinite(pixels_per_inch.x()) || pixels_per_inch.x() <= 0)
+    pixels_per_inch.set_x(input::kDefaultPixelsPerInch);
+  if (!std::isfinite(pixels_per_inch.y()) || pixels_per_inch.y() <= 0)
+    pixels_per_inch.set_y(input::kDefaultPixelsPerInch);
+  return pixels_per_inch;
 #else
   return gfx::Vector2dF(input::kDefaultPixelsPerInch,
                         input::kDefaultPixelsPerInch);

+    // task runner, not Android WebView's draw-scoped GPU thread. Configuration
+    // must complete before the first Draw; retaining it until Draw deadlocks
+    // the Browser waiting for this callback. Authorize only this OSR boundary.
+    gpu::ScopedAllowScheduleGpuTask allow_schedule_gpu_task;
+    // A replacement pool has no initialized content even when the page itself
+    // is static. The lease gate prevents drawing before the next admitted Begin.
+    aggregator_->SetFullDamageForSurface(current_surface_id_);
+    damage_tracker_->SetRootSurfaceDamaged();
+    skia_output_surface_->ConfigureRemoteKitOutput(std::move(config),
+                                                   std::move(callback));
+    return;
+  }
+#endif
+  std::move(callback).Run(false);
+}
+
+void Display::BeginRemoteKitFrame(
+    mojom::RemoteKitFrameTokenPtr token,
+    base::OnceCallback<void(mojom::RemoteKitFrameResultPtr)> callback) {
+  CHECK(!remotekit_frame_active_);
+#if BUILDFLAG(IS_WIN)
+  if (skia_output_surface_ && output_surface_->capabilities().remotekit_output) {
+    // The Windows OSR GPU runner is independently available. Queue selection on
+    // the existing FIFO before any renderer work from this BeginFrame interval.
+    gpu::ScopedAllowScheduleGpuTask allow_schedule_gpu_task;
+    remotekit_frame_active_ = true;
+    remotekit_frame_drawn_ = false;
+    skia_output_surface_->BeginRemoteKitFrame(std::move(token),
+                                              std::move(callback));
+    return;
+  }
+#endif
+  std::move(callback).Run(mojom::RemoteKitFrameResult::New(
+      std::move(token), mojom::RemoteKitFrameStatus::kNotReady));
+}
+
+void Display::FinishRemoteKitFrame() {
+#if BUILDFLAG(IS_WIN)
+  if (remotekit_frame_active_ && skia_output_surface_ &&
+      output_surface_->capabilities().remotekit_output) {
+    // No-draw retirement must run without a future Draw, on the same Windows
+    // OSR GPU FIFO after this interval's rendering/submit work.
+    gpu::ScopedAllowScheduleGpuTask allow_schedule_gpu_task;
+    remotekit_frame_active_ = false;
+    skia_output_surface_->FinishRemoteKitFrame(remotekit_frame_drawn_);
+  }
+#endif
+}

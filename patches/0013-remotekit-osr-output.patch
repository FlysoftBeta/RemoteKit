+// DXGI target itself. The Browser grants exclusive write ownership per token;
+// it must wait for the consumer fence before granting that target again.
+class VIZ_SERVICE_EXPORT SkiaOutputDeviceRemoteKit final
+    : public SkiaOutputDevice {
+ public:
+  using FrameCallback =
+      base::OnceCallback<void(mojom::RemoteKitFrameResultPtr)>;
+
+  SkiaOutputDeviceRemoteKit(
+      scoped_refptr<gpu::SharedContextState> context_state,
+      gpu::SharedImageFactory* shared_image_factory,
+      gpu::SharedImageRepresentationFactory* representation_factory,
+      scoped_refptr<gpu::MemoryTracker> memory_tracker,
+      DidSwapBufferCompleteCallback did_swap_buffer_complete_callback);
+  ~SkiaOutputDeviceRemoteKit() override;
+
+  bool Configure(mojom::RemoteKitOutputConfigPtr config);
+  void BeginFrame(mojom::RemoteKitFrameTokenPtr token, FrameCallback callback);
+  // Called for a frame which did not paint. Drawn frames normally finish in
+  // EndPaint after Submit; true is valid only after both operations completed.
+  void FinishFrame(bool drawn);
+
+  // Reject a stale resize grant before any target write, without losing GL.
+  bool PreparePaint();
+  bool Reshape(const ReshapeParams& params) override;
+  void Submit(scoped_refptr<gpu::SharedContextState> context_state,
+              bool sync_cpu,
+              base::OnceClosure callback) override;
+  void Present(const std::optional<gfx::Rect>& update_rect,
+               BufferPresentedCallback feedback,
+               OutputSurfaceFrame frame) override;
+
+ protected:
+  SkSurface* BeginPaint(
+      std::vector<GrBackendSemaphore>* end_semaphores) override;
+  void EndPaint() override;
+
+ private:
+  struct Target;
+  void Complete(mojom::RemoteKitFrameStatus status);
+  void ClearTargets();
+
+  scoped_refptr<gpu::SharedContextState> context_state_;
+  const raw_ptr<gpu::SharedImageFactory> shared_image_factory_;
+  const raw_ptr<gpu::SharedImageRepresentationFactory> representation_factory_;
+  Microsoft::WRL::ComPtr<ID3D11Device5> device_;
+  Microsoft::WRL::ComPtr<ID3D11DeviceContext4> immediate_context_;
+  std::vector<std::unique_ptr<Target>> targets_;
+  std::vector<Microsoft::WRL::ComPtr<ID3D11Fence>> ready_fences_;
+  std::vector<uint64_t> last_values_;
+  std::vector<uint64_t> last_signaled_values_;
+  uint64_t generation_ = 0;
+  gfx::Size target_size_;
+  gfx::Size reshape_size_;
+  mojom::RemoteKitFrameTokenPtr token_;
+  FrameCallback callback_;
+  std::unique_ptr<gpu::SkiaImageRepresentation::ScopedWriteAccess> write_access_;
+  bool painted_ = false;
+  bool submitted_ = false;
+  bool has_submitted_content_ = false;
+  bool lost_ = false;
+};
+
+}  // namespace viz
+
+#endif  // COMPONENTS_VIZ_SERVICE_DISPLAY_EMBEDDER_SKIA_OUTPUT_DEVICE_REMOTEKIT_H_

+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/viz/service/display_embedder/skia_output_device_remotekit.h"
+
+#include <dxgi1_2.h>
+
+#include <limits>
+#include <utility>
+
+#include "base/check_op.h"
+#include "gpu/command_buffer/common/shared_image_info.h"
+#include "gpu/command_buffer/service/shared_context_state.h"
+#include "gpu/command_buffer/service/shared_image/shared_image_factory.h"
+#include "mojo/public/cpp/platform/platform_handle.h"
+#include "third_party/skia/include/core/SkSurface.h"
+#include "third_party/skia/include/gpu/ganesh/GrDirectContext.h"
+#include "ui/gl/gl_angle_util_win.h"
+
+namespace viz {
+namespace {
+constexpr size_t kMaximumTargets = 5;
+
+uint64_t PackLuid(const LUID& luid) {
+  return (static_cast<uint64_t>(static_cast<uint32_t>(luid.HighPart)) << 32) |
+         luid.LowPart;
+}
+}  // namespace
+
+struct SkiaOutputDeviceRemoteKit::Target {
+  gpu::Mailbox mailbox;
+  std::unique_ptr<gpu::SkiaImageRepresentation> representation;
+};
+
+SkiaOutputDeviceRemoteKit::SkiaOutputDeviceRemoteKit(
+    scoped_refptr<gpu::SharedContextState> context_state,
+    gpu::SharedImageFactory* shared_image_factory,
+    gpu::SharedImageRepresentationFactory* representation_factory,
+    scoped_refptr<gpu::MemoryTracker> memory_tracker,
+    DidSwapBufferCompleteCallback did_swap_buffer_complete_callback)
+    : SkiaOutputDevice(context_state->gr_context(),
+                       nullptr,
+                       std::move(memory_tracker),
+                       std::move(did_swap_buffer_complete_callback)),
+      context_state_(std::move(context_state)),
+      shared_image_factory_(shared_image_factory),
+      representation_factory_(representation_factory) {
+  capabilities_.remotekit_output = true;
+  capabilities_.uses_default_gl_framebuffer = false;
+  capabilities_.output_surface_origin = gfx::SurfaceOrigin::kTopLeft;
+  // Each token can select a different target: incremental root rendering would
+  // preserve pixels belonging to an older frame in that target.
+  capabilities_.supports_post_sub_buffer = false;
+  capabilities_.sk_color_type_map[SinglePlaneFormat::kRGBA_8888] =
+      kBGRA_8888_SkColorType;
+  capabilities_.sk_color_type_map[SinglePlaneFormat::kRGBX_8888] =
+      kBGRA_8888_SkColorType;
+  capabilities_.sk_color_type_map[SinglePlaneFormat::kBGRA_8888] =
+      kBGRA_8888_SkColorType;
+  capabilities_.sk_color_type_map[SinglePlaneFormat::kBGRX_8888] =
+      kBGRA_8888_SkColorType;
+}
+
+SkiaOutputDeviceRemoteKit::~SkiaOutputDeviceRemoteKit() {
+  write_access_.reset();
+  Complete(mojom::RemoteKitFrameStatus::kLost);
+  ClearTargets();
+}
+
+void SkiaOutputDeviceRemoteKit::ClearTargets() {
+  for (auto& target : targets_) {
+    target->representation.reset();
+    shared_image_factory_->DestroySharedImage(target->mailbox);
+  }
+  targets_.clear();
+  ready_fences_.clear();
+  last_values_.clear();
+  last_signaled_values_.clear();
+  generation_ = 0;
+}
+
+bool SkiaOutputDeviceRemoteKit::Configure(
+    mojom::RemoteKitOutputConfigPtr config) {
+  if (token_ || write_access_ || !config || config->generation == 0 ||
+      config->generation <= generation_ || config->size.IsEmpty() ||
+      config->targets.empty() || config->targets.size() > kMaximumTargets ||
+      config->ready_fences.size() != config->targets.size() ||
+      !context_state_->GrContextIsGL() || !context_state_->gr_context() ||
+      context_state_->context_lost()) {
+    return false;
+  }
+  auto angle_device = gl::QueryD3D11DeviceObjectFromANGLE();
+  Microsoft::WRL::ComPtr<ID3D11Device5> device;
+  Microsoft::WRL::ComPtr<IDXGIDevice> dxgi_device;
+  Microsoft::WRL::ComPtr<IDXGIAdapter> adapter;
+  DXGI_ADAPTER_DESC adapter_desc = {};
+  if (!angle_device || FAILED(angle_device.As(&device)) ||
+      FAILED(angle_device.As(&dxgi_device)) ||
+      FAILED(dxgi_device->GetAdapter(&adapter)) ||
+      FAILED(adapter->GetDesc(&adapter_desc)) ||
+      PackLuid(adapter_desc.AdapterLuid) != config->adapter_luid) {
+    return false;
+  }
+  Microsoft::WRL::ComPtr<ID3D11DeviceContext> immediate;
+  Microsoft::WRL::ComPtr<ID3D11DeviceContext4> context;
+  device->GetImmediateContext(&immediate);
+  if (!immediate || FAILED(immediate.As(&context))) {
+    return false;
+  }
+
+  std::vector<Microsoft::WRL::ComPtr<ID3D11Fence>> fences;
+  for (auto& platform_handle : config->ready_fences) {
+    Microsoft::WRL::ComPtr<ID3D11Fence> fence;
+    if (!platform_handle.is_valid() ||
+        FAILED(device->OpenSharedFence(platform_handle.GetHandle().Get(),
+                                      IID_PPV_ARGS(&fence))) ||
+        fence->GetCompletedValue() == std::numeric_limits<uint64_t>::max()) {
+      return false;
+    }
+    fences.push_back(std::move(fence));
+  }
+  // Validate all resource descriptors before replacing the previous generation.
+  for (const auto& handle : config->targets) {
+    Microsoft::WRL::ComPtr<ID3D11Texture2D> texture;
+    if (handle.type != gfx::DXGI_SHARED_HANDLE ||
+        !handle.dxgi_handle().IsValid() ||
+        FAILED(device->OpenSharedResource1(handle.dxgi_handle().buffer_handle(),
+                                          IID_PPV_ARGS(&texture)))) {
+      return false;
+    }
+    D3D11_TEXTURE2D_DESC desc = {};
+    texture->GetDesc(&desc);
+    if (desc.Width != static_cast<UINT>(config->size.width()) ||
+        desc.Height != static_cast<UINT>(config->size.height()) ||
+        desc.Format != DXGI_FORMAT_B8G8R8A8_UNORM || desc.ArraySize != 1 ||
+        desc.MipLevels != 1 || desc.SampleDesc.Count != 1 ||
+        desc.Usage != D3D11_USAGE_DEFAULT ||
+        !(desc.BindFlags & D3D11_BIND_RENDER_TARGET) ||
+        !(desc.BindFlags & D3D11_BIND_SHADER_RESOURCE) ||
+        !(desc.MiscFlags & D3D11_RESOURCE_MISC_SHARED_NTHANDLE) ||
+        (desc.MiscFlags & D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX)) {
+      return false;
+    }
+  }
+
+  // Reconfiguration must not retire a target while this device's submitted
+  // rendering is still using it. Idle tokens consume last_values_ but do not
+  // queue a signal, so only compare values actually signaled on the GPU.
+  for (size_t i = 0; i < ready_fences_.size(); ++i) {
+    const uint64_t completed = ready_fences_[i]->GetCompletedValue();
+    if (completed == std::numeric_limits<uint64_t>::max()) {
+      lost_ = true;
+      return false;
+    }
+    if (completed < last_signaled_values_[i]) {
+      return false;
+    }
+  }
+  ClearTargets();
+  device_ = std::move(device);
+  immediate_context_ = std::move(context);
+  target_size_ = config->size;
+  for (auto& handle : config->targets) {
+    auto target = std::make_unique<Target>();
+    target->mailbox = gpu::Mailbox::Generate();
+    gpu::SharedImageInfo info(
+        SinglePlaneFormat::kBGRA_8888, target_size_,
+        gfx::ColorSpace::CreateSRGB(), kTopLeft_GrSurfaceOrigin,
+        kPremul_SkAlphaType,
+        gpu::SHARED_IMAGE_USAGE_DISPLAY_WRITE |
+            gpu::SHARED_IMAGE_USAGE_DISPLAY_READ,
+        "RemoteKitRootTarget");
+    if (!shared_image_factory_->CreateSharedImage(target->mailbox, info,
+                                                 std::move(handle))) {
+      ClearTargets();
+      lost_ = true;
+      return false;
+    }
+    target->representation =
+        representation_factory_->ProduceSkia(target->mailbox, context_state_);
+    targets_.push_back(std::move(target));
+    if (!targets_.back()->representation) {
+      ClearTargets();
+      lost_ = true;
+      return false;
+    }
+  }
+  ready_fences_ = std::move(fences);
+  last_values_.reserve(ready_fences_.size());
+  for (const auto& fence : ready_fences_) {
+    last_values_.push_back(fence->GetCompletedValue());
+  }
+  last_signaled_values_.assign(ready_fences_.size(), 0);
+  generation_ = config->generation;
+  has_submitted_content_ = false;
+  lost_ = false;
+  return true;
+}
+
+void SkiaOutputDeviceRemoteKit::BeginFrame(
+    mojom::RemoteKitFrameTokenPtr token,
+    FrameCallback callback) {
+  if (!token || token_ || lost_ || context_state_->context_lost() ||
+      token->generation != generation_ ||
+      token->target_index >= targets_.size() ||
+      token->value == 0 ||
+      token->value == std::numeric_limits<uint64_t>::max() ||
+      token->value <= last_values_[token->target_index]) {
+    std::move(callback).Run(mojom::RemoteKitFrameResult::New(
+        std::move(token), lost_ || context_state_->context_lost()
+                              ? mojom::RemoteKitFrameStatus::kLost
+                              : mojom::RemoteKitFrameStatus::kNotReady));
+    return;
+  }
+  // Consume the value even on an idle frame, preventing replay of a grant.
+  last_values_[token->target_index] = token->value;
+  token_ = std::move(token);
+  callback_ = std::move(callback);
+  painted_ = false;
+  submitted_ = false;
+}
+
+bool SkiaOutputDeviceRemoteKit::PreparePaint() {
+  if (lost_ || context_state_->context_lost()) {
+    Complete(mojom::RemoteKitFrameStatus::kLost);
+    return false;
+  }
+  if (!token_ || reshape_size_ != target_size_) {
+    Complete(mojom::RemoteKitFrameStatus::kNotReady);
+    return false;
+  }
+  return true;
+}
+
+bool SkiaOutputDeviceRemoteKit::Reshape(const ReshapeParams& params) {
+  if (params.transform != gfx::OVERLAY_TRANSFORM_NONE ||
+      params.GfxSize().IsEmpty() || params.sample_count != 1 ||
+      params.image_info.colorType() != kBGRA_8888_SkColorType) {
+    return false;
+  }
+  reshape_size_ = params.GfxSize();
+  return true;
+}
+
+SkSurface* SkiaOutputDeviceRemoteKit::BeginPaint(
+    std::vector<GrBackendSemaphore>* end_semaphores) {
+  if (!token_ || lost_ || context_state_->context_lost() || write_access_ ||
+      reshape_size_ != target_size_) {
+    Complete(mojom::RemoteKitFrameStatus::kLost);
+    return nullptr;
+  }
+  std::vector<GrBackendSemaphore> begin_semaphores;
+  auto& representation = targets_[token_->target_index]->representation;
+  write_access_ = representation->BeginScopedWriteAccess(
+      1, SkSurfaceProps(), gfx::Rect(target_size_), &begin_semaphores,
+      end_semaphores, gpu::SharedImageRepresentation::AllowUnclearedAccess::kYes);
+  if (!write_access_ || !write_access_->surface() ||
+      (!begin_semaphores.empty() &&
+       !write_access_->surface()->wait(begin_semaphores.size(),
+                                       begin_semaphores.data(), false))) {
+    write_access_.reset();
+    Complete(mojom::RemoteKitFrameStatus::kLost);
+    return nullptr;
+  }
+  painted_ = true;
+  return write_access_->surface();
+}
+
+void SkiaOutputDeviceRemoteKit::Submit(
+    scoped_refptr<gpu::SharedContextState> context_state,
+    bool sync_cpu,
+    base::OnceClosure callback) {
+  CHECK_EQ(context_state.get(), context_state_.get());
+  if (write_access_) {
+    write_access_->ApplyBackendSurfaceEndState();
+  }
+  submitted_ = !context_state_->context_lost() &&
+               context_state_->gr_context()->submit(
+                   sync_cpu ? GrSyncCpu::kYes : GrSyncCpu::kNo);
+  // PostSubmit destroys ScopedPaint, invoking EndPaint below only after the
+  // Ganesh command stream has been submitted to the ANGLE immediate context.
+  std::move(callback).Run();
+}
+
+void SkiaOutputDeviceRemoteKit::EndPaint() {
+  if (write_access_ && token_ && submitted_) {
+    targets_[token_->target_index]->representation->SetCleared();
+  }
+  write_access_.reset();
+  FinishFrame(true);
+}
+
+void SkiaOutputDeviceRemoteKit::FinishFrame(bool drawn) {
+  if (!token_) {
+    return;
+  }
+  if (lost_ || context_state_->context_lost()) {
+    Complete(mojom::RemoteKitFrameStatus::kLost);
+    return;
+  }
+  if (!drawn && !painted_ && !write_access_) {
+    const bool has_current_content =
+        has_submitted_content_ && !targets_.empty() &&
+        !target_size_.IsEmpty() && reshape_size_ == target_size_;
+    Complete(has_current_content ? mojom::RemoteKitFrameStatus::kIdle
+                                 : mojom::RemoteKitFrameStatus::kNotReady);
+    return;
+  }
+  if (!drawn || !painted_ || !submitted_ || write_access_ ||
+      context_state_->context_lost() ||
+      FAILED(device_->GetDeviceRemovedReason()) ||
+      FAILED(immediate_context_->Signal(ready_fences_[token_->target_index].Get(),
+                                         token_->value))) {
+    lost_ = true;
+    Complete(mojom::RemoteKitFrameStatus::kLost);
+    return;
+  }
+  // This submits a REAL GPU fence on the same D3D11 immediate context ANGLE
+  // used to render. kSubmitted means queued, not completed; the consumer must
+  // GPU-wait on this fence/value before touching the target.
+  last_signaled_values_[token_->target_index] = token_->value;
+  immediate_context_->Flush();
+  if (FAILED(device_->GetDeviceRemovedReason())) {
+    lost_ = true;
+    Complete(mojom::RemoteKitFrameStatus::kLost);
+    return;
+  }
+  has_submitted_content_ = true;
+  Complete(mojom::RemoteKitFrameStatus::kSubmitted);
+}
+
+void SkiaOutputDeviceRemoteKit::Complete(mojom::RemoteKitFrameStatus status) {
+  if (!callback_) {
+    return;
+  }
+  auto result = mojom::RemoteKitFrameResult::New(std::move(token_), status);
+  auto callback = std::move(callback_);
+  std::move(callback).Run(std::move(result));
+}
+
+void SkiaOutputDeviceRemoteKit::Present(
+    const std::optional<gfx::Rect>& update_rect,
+    BufferPresentedCallback feedback,
+    OutputSurfaceFrame frame) {
+  // Viz swap accounting only: no HWND, swapchain, or OS presentation.
+  StartSwapBuffers(std::move(feedback));
+  FinishSwapBuffers(
+      gfx::SwapCompletionResult(lost_ ? gfx::SwapResult::SWAP_FAILED
+                                      : gfx::SwapResult::SWAP_ACK),
+      reshape_size_, std::move(frame));
+}
+
+}  // namespace viz

+module viz.mojom;
+
+import "ui/gfx/geometry/mojom/geometry.mojom";
+import "ui/gfx/mojom/buffer_types.mojom";
+
+struct RemoteKitOutputConfig {
+  uint64 generation;
+  uint64 adapter_luid;
+  gfx.mojom.Size size;
+  array<gfx.mojom.GpuMemoryBufferHandle> targets;
+  array<handle<platform>> ready_fences;
+};
+
+struct RemoteKitFrameToken {
+  uint64 generation;
+  uint32 slot;
+  uint64 value;
+  uint32 target_index;
+};
+
+enum RemoteKitFrameStatus {
+  // The GPU signal has been queued, not necessarily completed.
+  kSubmitted,
+  kIdle,
+  kNotReady,
+  kLost,
+};
+
+struct RemoteKitFrameResult {
+  RemoteKitFrameToken token;
+  RemoteKitFrameStatus status;
+};

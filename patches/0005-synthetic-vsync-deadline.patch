+void VSyncThreadWin::WaitForFakeVSync(base::TimeDelta interval) {
+  TRACE_EVENT0("gpu", "WaitForVSync SyntheticDeadline");
+  DCHECK_GT(interval, base::TimeDelta());
+  bool reset_phase;
+  {
+    AutoVSyncThreadLock auto_lock(this);
+    reset_phase = reset_fake_vsync_phase_;
+    reset_fake_vsync_phase_ = false;
+  }
+
+  const auto now = base::TimeTicks::Now();
+  if (reset_phase || next_fake_vsync_.is_null() ||
+      now - next_fake_vsync_ >= interval * 4) {
+    next_fake_vsync_ = now + interval;
+  } else if (next_fake_vsync_ <= now) {
+    next_fake_vsync_ +=
+        interval * ((now - next_fake_vsync_).IntDiv(interval) + 1);
+  }
+
+  if (!fake_vsync_timer_initialized_) {
+    fake_vsync_timer_initialized_ = true;
+    fake_vsync_timer_.Set(::CreateWaitableTimerExW(
+        nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+        TIMER_MODIFY_STATE | SYNCHRONIZE));
+    if (!fake_vsync_timer_.is_valid()) {
+      fake_vsync_timer_.Set(::CreateWaitableTimerExW(
+          nullptr, nullptr, 0, TIMER_MODIFY_STATE | SYNCHRONIZE));
+    }
+  }
+
+  // Retain the original fake-vsync sleep path's process timer-resolution
+  // request for the entire wait, including when a waitable timer is used.
+  // Other delayed tasks in this GPU process may rely on the same resolution.
+  base::Time::ActivateHighResolutionTimer(true);
+  for (;;) {
+    const auto remaining = next_fake_vsync_ - base::TimeTicks::Now();
+    if (remaining <= base::TimeDelta()) {
+      break;
+    }
+    const DWORD timeout_ms =
+        static_cast<DWORD>(remaining.InMillisecondsRoundedUp());
+    if (fake_vsync_timer_.is_valid()) {
+      LARGE_INTEGER due_time;
+      // Negative 100ns units request a relative, one-shot wait. The phase is
+      // maintained in monotonic TimeTicks, independent of wall-clock changes.
+      due_time.QuadPart = -remaining.InNanoseconds() / 100;
+      if (due_time.QuadPart == 0) {
+        due_time.QuadPart = -1;
+      }
+      if (::SetWaitableTimer(fake_vsync_timer_.get(), &due_time, 0, nullptr,
+                             nullptr, FALSE) &&
+          ::WaitForSingleObject(fake_vsync_timer_.get(), timeout_ms) !=
+              WAIT_FAILED) {
+        continue;
+      }
+      fake_vsync_timer_.Close();
+    }
+    // Preserve the existing sleep fallback without accumulating its rounding
+    // and scheduling error into the next frame's phase.
+    ::Sleep(timeout_ms);
+  }
+  base::Time::ActivateHighResolutionTimer(false);
+
+  const auto wake_time = base::TimeTicks::Now();
+  next_fake_vsync_ +=
+      interval * ((wake_time - next_fake_vsync_).IntDiv(interval) + 1);
+}

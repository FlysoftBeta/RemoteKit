+
+bool PageLifecycleStateManager::SetIsFrozenWithAck(
+    bool frozen,
+    base::OnceClosure acknowledged) {
+  const auto& page_broadcast =
+      render_view_host_impl_->GetAssociatedPageBroadcast();
+  if (!page_broadcast || !page_broadcast.is_connected())
+    return false;
+
+  frozen_explicitly_ = frozen;
+  SendUpdatesToRendererIfNeeded(nullptr, std::move(acknowledged));
+  return true;
 }
 

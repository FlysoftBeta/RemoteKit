+// Each callback independently owns its context. Finished may run before
+// submitted (including on failure); neither wrapper dereferences the other's
+// context.
+struct CopyProfileSubmitted {
+  uint64_t id;
+  GrGpuSubmittedProc original;
+  raw_ptr<void> original_context;
+  static void Run(void* context, bool success) {
+    auto owned = std::unique_ptr<CopyProfileSubmitted>(
+        static_cast<CopyProfileSubmitted*>(context));
+    TRACE_EVENT_INSTANT("gpu.capture", "RemoteKitCopySubmitted", "request_id",
+                        owned->id, "success", success);
+    auto* forwarded_context = owned->original_context.get();
+    owned->original_context = nullptr;
+    if (owned->original) {
+      owned->original(forwarded_context, success);
+    }
+  }
+};
+
+struct CopyProfileGaneshFinished {
+  uint64_t id;
+  GrGpuFinishedProc original;
+  GrGpuFinishedWithStatsProc original_stats;
+  raw_ptr<void> original_context;
+  static void Run(void* context) { WithStats(context, {}); }
+  static void WithStats(void* context, const skgpu::GpuStats& stats) {
+    auto owned = std::unique_ptr<CopyProfileGaneshFinished>(
+        static_cast<CopyProfileGaneshFinished*>(context));
+    TRACE_EVENT_INSTANT("gpu.capture", "RemoteKitCopyFinished", "request_id",
+                        owned->id, "flush_batch_elapsed_ns", stats.elapsedTime,
+                        "elapsed_available", stats.elapsedTime != 0);
+    auto* forwarded_context = owned->original_context.get();
+    owned->original_context = nullptr;
+    if (owned->original_stats) {
+      owned->original_stats(forwarded_context, stats);
+    } else if (owned->original) {
+      owned->original(forwarded_context);
+    }
+  }
+};
+
+struct CopyProfileGraphiteFinished {
+  uint64_t id;
+  skgpu::graphite::GpuFinishedProc original;
+  skgpu::graphite::GpuFinishedWithStatsProc original_stats;
+  raw_ptr<void> original_context;
+  static void Run(void* context, skgpu::CallbackResult result) {
+    WithStats(context, result, {});
+  }
+  static void WithStats(void* context,
+                        skgpu::CallbackResult result,
+                        const skgpu::GpuStats& stats) {
+    auto owned = std::unique_ptr<CopyProfileGraphiteFinished>(
+        static_cast<CopyProfileGraphiteFinished*>(context));
+    TRACE_EVENT_INSTANT("gpu.capture", "RemoteKitCopyFinished", "request_id",
+                        owned->id, "flush_batch_elapsed_ns", stats.elapsedTime,
+                        "elapsed_available", stats.elapsedTime != 0, "result",
+                        static_cast<int>(result));
+    auto* forwarded_context = owned->original_context.get();
+    owned->original_context = nullptr;
+    if (owned->original_stats) {
+      owned->original_stats(forwarded_context, result, stats);
+    } else if (owned->original) {
+      owned->original(forwarded_context, result);
+    }
+  }
+};

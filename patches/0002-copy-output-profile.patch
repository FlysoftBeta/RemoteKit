diff --git a/components/viz/service/display_embedder/remote_kit_gpu_profile.h b/components/viz/service/display_embedder/remote_kit_gpu_profile.h
new file mode 100644
index 0000000000000..d2e488a90b863
--- /dev/null
+++ b/components/viz/service/display_embedder/remote_kit_gpu_profile.h
@@ -0,0 +1,125 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef COMPONENTS_VIZ_SERVICE_DISPLAY_EMBEDDER_REMOTE_KIT_GPU_PROFILE_H_
+#define COMPONENTS_VIZ_SERVICE_DISPLAY_EMBEDDER_REMOTE_KIT_GPU_PROFILE_H_
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "base/trace_event/trace_event.h"
+#include "components/viz/service/viz_service_export.h"
+#include "third_party/skia/include/core/SkSurface.h"
+#include "third_party/skia/include/gpu/ganesh/GrDirectContext.h"
+#include "third_party/skia/include/private/chromium/GrSurfaceCharacterization.h"
+
+namespace viz {
+VIZ_SERVICE_EXPORT uint64_t RemoteKitNextGpuProfileId();
+// Only constructed when the explicit CopyOutput profiling feature is enabled.
+// Frame is local to one output surface, ending at SwapBuffers[Skipped].
+struct RemoteKitGpuProfile {
+  uint64_t output;
+  uint64_t frame;
+  uint64_t pass;
+  const char* scope;
+};
+
+struct RemoteKitGpuFinished {
+  uint64_t id;
+  GrGpuFinishedProc original;
+  GrGpuFinishedWithStatsProc original_stats;
+  raw_ptr<void> original_context;
+  bool elapsed_supported;
+  // Skia's abandoned path only invokes the plain callback. Preserve that
+  // behavior even when the original flush also supplied a stats callback.
+  static void Run(void* context) {
+    std::unique_ptr<RemoteKitGpuFinished> owned(
+        static_cast<RemoteKitGpuFinished*>(context));
+    TRACE_EVENT_INSTANT("gpu.capture", "RemoteKitVizFinished", "scope_id",
+                        owned->id, "flush_batch_elapsed_ns", uint64_t{0},
+                        "elapsed_available", false);
+    void* original_context = owned->original_context.get();
+    owned->original_context = nullptr;
+    if (owned->original)
+      owned->original(original_context);
+  }
+  static void WithStats(void* context, const skgpu::GpuStats& stats) {
+    std::unique_ptr<RemoteKitGpuFinished> owned(
+        static_cast<RemoteKitGpuFinished*>(context));
+    TRACE_EVENT_INSTANT("gpu.capture", "RemoteKitVizFinished", "scope_id",
+                        owned->id, "flush_batch_elapsed_ns", stats.elapsedTime,
+                        "elapsed_available",
+                        owned->elapsed_supported && stats.elapsedTime != 0);
+    void* original_context = owned->original_context.get();
+    owned->original_context = nullptr;
+    if (owned->original_stats) {
+      owned->original_stats(original_context, stats);
+    } else if (owned->original) {
+      owned->original(original_context);
+    }
+  }
+};
+struct RemoteKitGpuSubmitted {
+  uint64_t id;
+  GrGpuSubmittedProc original;
+  raw_ptr<void> original_context;
+  static void Run(void* context, bool success) {
+    std::unique_ptr<RemoteKitGpuSubmitted> owned(
+        static_cast<RemoteKitGpuSubmitted*>(context));
+    TRACE_EVENT_INSTANT("gpu.capture", "RemoteKitVizSubmitted", "scope_id",
+                        owned->id, "success", success);
+    void* original_context = owned->original_context.get();
+    owned->original_context = nullptr;
+    if (owned->original) {
+      owned->original(original_context, success);
+    }
+  }
+};
+// Attach after existing cleanup composition. No extra flush, submit or wait.
+inline uint64_t RemoteKitProfileFlush(const RemoteKitGpuProfile& profile,
+                                      SkSurface* surface,
+                                      GrDirectContext* context,
+                                      GrFlushInfo* info) {
+  const uint64_t id = RemoteKitNextGpuProfileId();
+  GrSurfaceCharacterization characterization;
+  const bool characterized = surface->characterize(&characterization);
+  const auto supported = context->supportedGpuStats();
+  const bool elapsed =
+      static_cast<bool>(supported & skgpu::GpuStatsFlags::kElapsedTime);
+  TRACE_EVENT_INSTANT(
+      "gpu.capture", "RemoteKitVizFlushBegin", "scope_id", id, "scope",
+      profile.scope, "output_surface_id", profile.output, "frame",
+      profile.frame, "pass", profile.pass, "context_id",
+      reinterpret_cast<uint64_t>(context), "surface_id",
+      reinterpret_cast<uint64_t>(surface), "width", surface->width(), "height",
+      surface->height(), "color_type",
+      static_cast<int>(surface->imageInfo().colorType()), "sample_count",
+      characterized ? characterization.sampleCount() : -1, "characterized",
+      characterized, "backend_api", static_cast<int>(context->backend()),
+      "supported_flags", static_cast<uint32_t>(supported), "elapsed_supported",
+      elapsed, "semaphore_count", info->fNumSemaphores);
+  auto* finished = new RemoteKitGpuFinished{id, info->fFinishedProc,
+                                            info->fFinishedWithStatsProc,
+                                            info->fFinishedContext, elapsed};
+  info->fFinishedContext = finished;
+  info->fFinishedProc = &RemoteKitGpuFinished::Run;
+  if (elapsed || finished->original_stats) {
+    if (elapsed) {
+      info->fGpuStatsFlags |= skgpu::GpuStatsFlags::kElapsedTime;
+    }
+    info->fFinishedWithStatsProc = &RemoteKitGpuFinished::WithStats;
+  }
+  auto* submitted = new RemoteKitGpuSubmitted{id, info->fSubmittedProc,
+                                              info->fSubmittedContext};
+  info->fSubmittedContext = submitted;
+  info->fSubmittedProc = &RemoteKitGpuSubmitted::Run;
+  return id;
+}
+inline void RemoteKitProfileFlushReturn(uint64_t id,
+                                        GrSemaphoresSubmitted result) {
+  TRACE_EVENT_INSTANT("gpu.capture", "RemoteKitVizFlushReturn", "scope_id", id,
+                      "semaphores_submitted",
+                      result == GrSemaphoresSubmitted::kYes);
+}
+}  // namespace viz
+#endif

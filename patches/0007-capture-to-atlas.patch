+namespace viz {
+namespace {
+
+class CaptureToAtlasCopyOutputRequestTest : public testing::Test {
+ protected:
+  std::unique_ptr<CopyOutputRequest> Request(
+      std::string_view label = "RemoteKitCaptureToAtlas") {
+    image_ = CopyOutputSharedImageResult::CreateUnownedSharedImage(
+        CopyOutputResult::Format::RGBA, gfx::Size(80, 64),
+        gpu::Mailbox::Generate(), gfx::ColorSpace::CreateSRGB(), label);
+    auto request = std::make_unique<CopyOutputRequest>(
+        CopyOutputResult::Format::RGBA,
+        CopyOutputResult::Destination::kSharedImage,
+        base::BindOnce(
+            [](std::unique_ptr<CopyOutputResult>* output, unsigned* count,
+               std::unique_ptr<CopyOutputResult> result) {
+              ++*count;
+              *output = std::move(result);
+            },
+            &result_, &result_count_));
+    request->set_result_selection(gfx::Rect(64, 48));
+    request->set_blit_request(BlitRequest(gfx::Point(4, 4),
+                                          LetterboxingBehavior::kLetterbox,
+                                          image_, gpu::SyncToken(), true));
+    return request;
+  }
+
+  void Drain() { base::RunLoop().RunUntilIdle(); }
+
+  base::SingleThreadTaskExecutor executor_;
+  scoped_refptr<gpu::ClientSharedImage> image_;
+  std::unique_ptr<CopyOutputResult> result_;
+  unsigned result_count_ = 0;
+};
+
+TEST_F(CaptureToAtlasCopyOutputRequestTest, UnsatisfiedBeforeGpuIsTyped) {
+  auto request = Request();
+  EXPECT_FALSE(request->gpu_work_started());
+  request.reset();
+  Drain();
+  ASSERT_TRUE(result_);
+  EXPECT_EQ(result_count_, 1u);
+  EXPECT_TRUE(result_->IsEmpty());
+  EXPECT_EQ(result_->error(), CopyOutputResult::Error::kCancelledBeforeGpu);
+  EXPECT_EQ(result_->format(), CopyOutputResult::Format::RGBA);
+  EXPECT_EQ(result_->destination(),
+            CopyOutputResult::Destination::kSharedImage);
+}
+
+TEST_F(CaptureToAtlasCopyOutputRequestTest,
+       AdmittedGpuWorkCannotBecomeRetryable) {
+  auto request = Request();
+  request->MarkGpuWorkStarted();
+  EXPECT_TRUE(request->gpu_work_started());
+  request.reset();
+  Drain();
+  ASSERT_TRUE(result_);
+  EXPECT_EQ(result_count_, 1u);
+  EXPECT_TRUE(result_->IsEmpty());
+  EXPECT_EQ(result_->error(), CopyOutputResult::Error::kUnknown);
+}
+
+TEST_F(CaptureToAtlasCopyOutputRequestTest, ExplicitUnknownRemainsUnknown) {
+  auto request = Request();
+  request->SendError(CopyOutputResult::Error::kUnknown);
+  request.reset();
+  Drain();
+  ASSERT_TRUE(result_);
+  EXPECT_EQ(result_count_, 1u);
+  EXPECT_TRUE(result_->IsEmpty());
+  EXPECT_EQ(result_->error(), CopyOutputResult::Error::kUnknown);
+}
+
+TEST_F(CaptureToAtlasCopyOutputRequestTest, SuccessRemainsNonempty) {
+  auto request = Request();
+  request->MarkGpuWorkStarted();
+  request->SendResult(std::make_unique<CopyOutputSharedImageResult>(
+      CopyOutputResult::Format::RGBA, gfx::Rect(64, 48), image_,
+      ReleaseCallback()));
+  request.reset();
+  Drain();
+  ASSERT_TRUE(result_);
+  EXPECT_EQ(result_count_, 1u);
+  EXPECT_FALSE(result_->IsEmpty());
+  EXPECT_EQ(result_->error(), CopyOutputResult::Error::kNone);
+  EXPECT_TRUE(result_->size() == gfx::Size(64, 48));
+}
+
+TEST_F(CaptureToAtlasCopyOutputRequestTest, OrdinaryPoolRemainsUnknown) {
+  auto request = Request("ordinary-capture-pool");
+  request.reset();
+  Drain();
+  ASSERT_TRUE(result_);
+  EXPECT_EQ(result_count_, 1u);
+  EXPECT_TRUE(result_->IsEmpty());
+  EXPECT_EQ(result_->error(), CopyOutputResult::Error::kUnknown);
+}
+
+}  // namespace
+}  // namespace viz

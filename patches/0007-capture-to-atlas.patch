+    // cannot release the Context while that member is still being destroyed.
+    CHECK(owning_task_runner()->RunsTasksInCurrentSequence());
+    owning_task_runner()->PostTask(
+        FROM_HERE, base::BindOnce(&Generation::ReturnSlot,
+                                  base::WrapRefCounted(this), slot, token));
+  }
+
+  void ReturnSlot(size_t slot, const gpu::SyncToken& token) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker);
+    CHECK(busy[slot]);
+    if (token.HasData()) {
+      tokens[slot] = token;
+    }
+    busy[slot] = false;
+  }
+
+  const uint64_t generation;
+  const gfx::Size atlas_size;
+  const gfx::Rect visible_rect;
+  std::unique_ptr<Context> context;
+  std::array<scoped_refptr<gpu::ClientSharedImage>, 3> images;
+  std::array<gpu::SyncToken, 3> tokens;
+  std::array<bool, 3> busy = {};
+  bool valid = true;
+  SEQUENCE_CHECKER(sequence_checker);
+
+ private:
+  friend class base::RefCountedDeleteOnSequence<Generation>;
+  friend class base::DeleteHelper<Generation>;
+  ~Generation() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker);
+    for (size_t i = 0; i < images.size(); ++i) {
+      CHECK(!busy[i]);
+      if (images[i]) {
+        context->DestroySharedImage(tokens[i], std::move(images[i]));
+      }
+    }
+  }
+};
+
+std::unique_ptr<CaptureToAtlasVideoFramePool>
+CaptureToAtlasVideoFramePool::Create(
+    uint64_t generation,
+    const gfx::Size& atlas_size,
+    const gfx::Rect& visible_rect,
+    std::vector<gfx::GpuMemoryBufferHandle> buffers,
+    std::unique_ptr<Context> context,
+    std::string& reason) {
+  if (!generation || atlas_size.IsEmpty() || visible_rect.IsEmpty() ||
+      atlas_size.width() > media::limits::kMaxDimension ||
+      atlas_size.height() > media::limits::kMaxDimension ||
+      !gfx::Rect(atlas_size).Contains(visible_rect)) {
+    reason = "invalid generation or atlas geometry";
+    return nullptr;
+  }
+  if (!context || buffers.size() != 3) {
+    reason = "a context and exactly three destinations are required";
+    return nullptr;
+  }
+#if BUILDFLAG(IS_WIN)
+  for (size_t i = 0; i < buffers.size(); ++i) {
+    if (buffers[i].type != gfx::DXGI_SHARED_HANDLE ||
+        !buffers[i].dxgi_handle().IsValid()) {
+      reason = "destination is not a valid DXGI shared handle";
+      return nullptr;
+    }
+    for (size_t j = 0; j < i; ++j) {
+      if (buffers[i].dxgi_handle().token() ==
+          buffers[j].dxgi_handle().token()) {
+        reason = "destination handles must identify three distinct resources";
+        return nullptr;
+      }
+    }
+  }
+#else
+  reason = "capture-to-atlas requires Windows GL/Ganesh";
+  return nullptr;
+#endif
+  auto state = base::MakeRefCounted<Generation>(
+      generation, atlas_size, visible_rect, std::move(context));
+  for (size_t i = 0; i < buffers.size(); ++i) {
+    state->images[i] = state->context->ImportCaptureToAtlasImage(
+        atlas_size, std::move(buffers[i]), state->tokens[i]);
+    if (!state->images[i]) {
+      reason = "destination import unavailable or failed (requires GL/Ganesh)";
+      return nullptr;
+    }
+  }
+  reason.clear();
+  return std::unique_ptr<CaptureToAtlasVideoFramePool>(
+      new CaptureToAtlasVideoFramePool(std::move(state)));
+}
+
+CaptureToAtlasVideoFramePool::CaptureToAtlasVideoFramePool(
+    scoped_refptr<Generation> state)
+    : VideoFramePool(3), state_(std::move(state)) {}
+CaptureToAtlasVideoFramePool::~CaptureToAtlasVideoFramePool() = default;
+
+scoped_refptr<media::VideoFrame>
+CaptureToAtlasVideoFramePool::ReserveVideoFrame(media::VideoPixelFormat format,
+                                                const gfx::Size& size) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(state_->sequence_checker);
+  if (!state_->valid || format != media::PIXEL_FORMAT_ARGB ||
+      size != state_->visible_rect.size()) {
+    return nullptr;
+  }
+  for (size_t i = 0; i < state_->images.size(); ++i) {
+    if (state_->busy[i]) {
+      continue;
+    }
+    auto frame = media::VideoFrame::WrapMappableSharedImage(
+        state_->images[i], state_->tokens[i],
+        media::VideoFrame::ReleaseMailboxCB(), state_->visible_rect,
+        state_->visible_rect.size(), base::TimeDelta());
+    if (!frame) {
+      return nullptr;
+    }
+    state_->busy[i] = true;
+    // A strong generation reference crosses both the frame lifetime and the
+    // post back to the reservation sequence. Stop is never treated as a drain.
+    frame->SetReleaseMailboxCB(
+        base::BindOnce(&Generation::OnFrameDestroyed, state_, i));
+    frame->metadata().read_lock_fences_enabled = true;
+    frame->set_color_space(state_->images[i]->color_space());
+    return frame;
+  }
+  return nullptr;
+}
+
+media::mojom::VideoBufferHandlePtr
+CaptureToAtlasVideoFramePool::CloneHandleForDelivery(
+    const media::VideoFrame& frame) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(state_->sequence_checker);
+  CHECK(frame.HasMappableSharedImage());
+  return media::mojom::VideoBufferHandle::NewGpuMemoryBufferHandle(
+      frame.GetGpuMemoryBufferHandle());
+}
+
+size_t CaptureToAtlasVideoFramePool::GetNumberOfReservedFrames() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(state_->sequence_checker);
+  size_t reserved = 0;
+  for (bool busy : state_->busy) {
+    reserved += busy;
+  }
+  return reserved;
+}
+
+base::OnceClosure
+CaptureToAtlasVideoFramePool::MakeUnexpectedDeliveryDisconnectCallback(
+    base::OnceClosure invalidate_capturer) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(state_->sequence_checker);
+  return base::BindOnce(&Generation::OnUnexpectedDeliveryDisconnect, state_,
+                        std::move(invalidate_capturer));
+}
+
+void CaptureToAtlasVideoFramePool::InvalidateBuffers() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(state_->sequence_checker);
+  state_->valid = false;
+}
+
+}  // namespace viz

+void FrameSinkVideoCapturerImpl::ConfigureCaptureToAtlas(
+    uint64_t generation,
+    const gfx::Size& atlas_size,
+    const gfx::Rect& visible_rect,
+    std::vector<gfx::GpuMemoryBufferHandle> buffers,
+    ConfigureCaptureToAtlasCallback callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (video_capture_started_ || capture_to_atlas_generation_ ||
+      capture_to_atlas_invalidated_) {
+    std::move(callback).Run(false,
+                            "configure requires a fresh stopped capturer");
+    return;
+  }
+  if (pixel_format_ != media::PIXEL_FORMAT_ARGB ||
+      !gmb_video_frame_pool_context_provider_ || !resolved_target_) {
+    std::move(callback).Run(false,
+                            "ARGB, GPU context and resolved target required");
+    return;
+  }
+  auto context = gmb_video_frame_pool_context_provider_->CreateContext(
+      base::BindOnce(&FrameSinkVideoCapturerImpl::InvalidateCaptureToAtlas,
+                     capture_to_atlas_weak_factory_.GetWeakPtr(),
+                     "GPU context lost", false));
+  std::string reason;
+  auto pool = CaptureToAtlasVideoFramePool::Create(
+      generation, atlas_size, visible_rect, std::move(buffers),
+      std::move(context), reason);
+  if (!pool) {
+    std::move(callback).Run(false, reason);
+    return;
+  }
+  MarkFrame(nullptr);
+  capture_to_atlas_generation_ = generation;
+  capture_to_atlas_visible_rect_ = visible_rect;
+  frame_pool_ = std::move(pool);
+  LOG(INFO) << "RemoteKitCaptureToAtlas configured generation=" << generation
+            << " atlas=" << atlas_size.ToString()
+            << " visible=" << visible_rect.ToString() << " slots=3";
+  std::move(callback).Run(true, "");
+}
+
+void FrameSinkVideoCapturerImpl::InvalidateCaptureToAtlas(
+    const std::string& reason,
+    bool reconfigure) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!capture_to_atlas_generation_ || capture_to_atlas_invalidated_) {
+    return;
+  }
+  capture_to_atlas_invalidated_ = true;
+  LOG(ERROR) << "RemoteKitCaptureToAtlas invalidated generation="
+             << capture_to_atlas_generation_ << " reason=" << reason;
+  Stop();
+  if (resolved_target_) {
+    resolved_target_->DetachCaptureClient(this);
+    resolved_target_ = nullptr;
+  }
+  if (frame_pool_) {
+    frame_pool_->InvalidateBuffers();
+  }
+  frame_pool_.reset();
+  if (receiver_.is_bound()) {
+    receiver_.ResetWithReason(reconfigure ? 1u : 0u, reason);
+    // Do not erase the owner entry while a target/manager notification is
+    // iterating it. The weak callback is canceled if shutdown destroys us.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            &FrameSinkVideoCapturerImpl::DeleteInvalidatedCaptureToAtlas,
+            capture_to_atlas_weak_factory_.GetWeakPtr()));
+  }
+}
+
+void FrameSinkVideoCapturerImpl::DeleteInvalidatedCaptureToAtlas() {
+  frame_sink_manager_->OnCapturerConnectionLost(this);
+}

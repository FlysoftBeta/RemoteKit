+TEST(CaptureToAtlasVideoFramePoolTest, UnexpectedDeliveryDisconnectSealsPool) {
+  base::SingleThreadTaskExecutor tasks;
+  Counts counts;
+  std::string reason;
+  auto pool = CaptureToAtlasVideoFramePool::Create(
+      3, gfx::Size(80, 64), gfx::Rect(4, 4, 64, 48), Handles(),
+      std::make_unique<FakeAtlasContext>(&counts), reason);
+  ASSERT_TRUE(pool) << reason;
+  auto frame =
+      pool->ReserveVideoFrame(media::PIXEL_FORMAT_ARGB, gfx::Size(64, 48));
+  ASSERT_TRUE(frame);
+  bool frozen = false;
+  auto delivery = std::make_unique<InFlightFrameDelivery>(
+      base::BindOnce([](scoped_refptr<media::VideoFrame>) {}, std::move(frame)),
+      base::OnceCallback<void(const media::VideoCaptureFeedback&)>(),
+      pool->MakeUnexpectedDeliveryDisconnectCallback(base::BindOnce(
+          [](CaptureToAtlasVideoFramePool* pool, bool* frozen) {
+            // Freeze precedes notification and the posted VideoFrame return.
+            EXPECT_FALSE(pool->ReserveVideoFrame(media::PIXEL_FORMAT_ARGB,
+                                                 gfx::Size(64, 48)));
+            *frozen = true;
+          }, base::Unretained(pool.get()), &frozen)));
+  mojo::Remote<mojom::FrameSinkVideoConsumerFrameCallbacks> callbacks;
+  mojo::MakeSelfOwnedReceiver(std::move(delivery),
+                              callbacks.BindNewPipeAndPassReceiver());
+  // Close the actual frame callback pipe without Done, independently of the
+  // capturer control pipe. Mojo destroys its self-owned delivery receiver.
+  callbacks.reset();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(frozen);
+  EXPECT_FALSE(
+      pool->ReserveVideoFrame(media::PIXEL_FORMAT_ARGB, gfx::Size(64, 48)));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(pool->GetNumberOfReservedFrames(), 0u);
+  EXPECT_FALSE(
+      pool->ReserveVideoFrame(media::PIXEL_FORMAT_ARGB, gfx::Size(64, 48)));
+  pool.reset();
+  EXPECT_TRUE(counts.context_destroyed);
+}

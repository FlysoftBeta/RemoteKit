+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace viz {
+#if BUILDFLAG(IS_WIN)
+namespace {
+struct Counts {
+  int imported = 0;
+  int destroyed = 0;
+  bool context_destroyed = false;
+};
+
+class FakeAtlasContext : public CaptureToAtlasVideoFramePool::Context {
+ public:
+  explicit FakeAtlasContext(Counts* counts, int fail_at = -1)
+      : counts_(counts), fail_at_(fail_at) {}
+  ~FakeAtlasContext() override { counts_->context_destroyed = true; }
+  scoped_refptr<gpu::ClientSharedImage> CreateSharedImage(
+      const gfx::Size&,
+      gfx::BufferUsage,
+      const SharedImageFormat&,
+      const gfx::ColorSpace&,
+      gpu::SharedImageUsageSet,
+      gpu::SyncToken&) override {
+    ADD_FAILURE() << "fixed pool must never allocate a destination";
+    return nullptr;
+  }
+  scoped_refptr<gpu::ClientSharedImage> ImportCaptureToAtlasImage(
+      const gfx::Size& size,
+      gfx::GpuMemoryBufferHandle,
+      gpu::SyncToken&) override {
+    if (counts_->imported == fail_at_) {
+      return nullptr;
+    }
+    ++counts_->imported;
+    gpu::SharedImageMetadata metadata;
+    metadata.format = SinglePlaneFormat::kBGRA_8888;
+    metadata.size = size;
+    metadata.color_space = gfx::ColorSpace::CreateSRGB();
+    // CPU shared memory provides a real mappable CSI without a GPU/device.
+    return gpu::ClientSharedImage::CreateForTesting(
+        gpu::Mailbox::Generate(), metadata, gpu::SyncToken(), false,
+        base::BindRepeating(
+            [](gpu::ClientSharedImage::AsyncMapCompletionCallback cb) {
+              std::move(cb).Run(true);
+            }),
+        gfx::BufferUsage::GPU_READ_CPU_READ_WRITE,
+        base::MakeRefCounted<gpu::SharedImageInterfaceHolder>(nullptr));
+  }
+  void DestroySharedImage(
+      const gpu::SyncToken&,
+      scoped_refptr<gpu::ClientSharedImage> image) override {
+    EXPECT_FALSE(counts_->context_destroyed);
+    EXPECT_TRUE(image);
+    ++counts_->destroyed;
+  }
+  const gpu::SharedImageCapabilities& GetCapabilities() override {
+    return capabilities_;
+  }
+
+ private:
+  raw_ptr<Counts> counts_;
+  int fail_at_;
+  gpu::SharedImageCapabilities capabilities_;
+};
+
+std::vector<gfx::GpuMemoryBufferHandle> Handles() {
+  std::vector<gfx::GpuMemoryBufferHandle> handles;
+  for (int i = 0; i < 3; ++i) {
+    handles.emplace_back(gfx::DXGIHandle::CreateFakeForTest());
+  }
+  return handles;
+}
+
+TEST(CaptureToAtlasVideoFramePoolTest, ExhaustionAndPostedReturn) {
+  base::SingleThreadTaskExecutor tasks;
+  Counts counts;
+  std::string reason;
+  auto pool = CaptureToAtlasVideoFramePool::Create(
+      1, gfx::Size(80, 64), gfx::Rect(4, 4, 64, 48), Handles(),
+      std::make_unique<FakeAtlasContext>(&counts), reason);
+  ASSERT_TRUE(pool) << reason;
+  auto a = pool->ReserveVideoFrame(media::PIXEL_FORMAT_ARGB, gfx::Size(64, 48));
+  auto b = pool->ReserveVideoFrame(media::PIXEL_FORMAT_ARGB, gfx::Size(64, 48));
+  auto c = pool->ReserveVideoFrame(media::PIXEL_FORMAT_ARGB, gfx::Size(64, 48));
+  ASSERT_TRUE(a);
+  ASSERT_TRUE(b);
+  ASSERT_TRUE(c);
+  EXPECT_TRUE(a->coded_size() == gfx::Size(80, 64));
+  EXPECT_TRUE(a->visible_rect() == gfx::Rect(4, 4, 64, 48));
+  EXPECT_TRUE(a->natural_size() == gfx::Size(64, 48));
+  EXPECT_EQ(pool->GetNumberOfReservedFrames(), 3u);
+  EXPECT_FALSE(
+      pool->ReserveVideoFrame(media::PIXEL_FORMAT_ARGB, gfx::Size(64, 48)));
+  a.reset();
+  EXPECT_EQ(pool->GetNumberOfReservedFrames(), 3u);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(pool->GetNumberOfReservedFrames(), 2u);
+  a = pool->ReserveVideoFrame(media::PIXEL_FORMAT_ARGB, gfx::Size(64, 48));
+  ASSERT_TRUE(a);
+  EXPECT_EQ(counts.imported, 3);
+  pool->InvalidateBuffers();
+  EXPECT_FALSE(
+      pool->ReserveVideoFrame(media::PIXEL_FORMAT_ARGB, gfx::Size(64, 48)));
+  a.reset();
+  b.reset();
+  c.reset();
+  base::RunLoop().RunUntilIdle();
+  pool.reset();
+  EXPECT_EQ(counts.destroyed, 3);
+  EXPECT_TRUE(counts.context_destroyed);
+}
+
+TEST(CaptureToAtlasVideoFramePoolTest, GenerationOutlivesPoolAndPostedReturn) {
+  base::SingleThreadTaskExecutor tasks;
+  Counts counts;
+  std::string reason;
+  auto pool = CaptureToAtlasVideoFramePool::Create(
+      2, gfx::Size(80, 64), gfx::Rect(4, 4, 64, 48), Handles(),
+      std::make_unique<FakeAtlasContext>(&counts), reason);
+  ASSERT_TRUE(pool) << reason;
+  auto frame =
+      pool->ReserveVideoFrame(media::PIXEL_FORMAT_ARGB, gfx::Size(64, 48));
+  ASSERT_TRUE(frame);
+  pool.reset();
+  EXPECT_FALSE(counts.context_destroyed);
+  EXPECT_EQ(counts.destroyed, 0);
+  frame.reset();
+  EXPECT_FALSE(counts.context_destroyed);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(counts.destroyed, 3);
+  EXPECT_TRUE(counts.context_destroyed);
+}
+
+TEST(CaptureToAtlasVideoFramePoolTest, UnexpectedDeliveryDisconnectSealsPool) {
+  base::SingleThreadTaskExecutor tasks;
+  Counts counts;
+  std::string reason;
+  auto pool = CaptureToAtlasVideoFramePool::Create(
+      3, gfx::Size(80, 64), gfx::Rect(4, 4, 64, 48), Handles(),
+      std::make_unique<FakeAtlasContext>(&counts), reason);
+  ASSERT_TRUE(pool) << reason;
+  auto frame =
+      pool->ReserveVideoFrame(media::PIXEL_FORMAT_ARGB, gfx::Size(64, 48));
+  ASSERT_TRUE(frame);
+  bool frozen = false;
+  auto delivery = std::make_unique<InFlightFrameDelivery>(
+      base::BindOnce([](scoped_refptr<media::VideoFrame>) {}, std::move(frame)),
+      base::OnceCallback<void(const media::VideoCaptureFeedback&)>(),
+      pool->MakeUnexpectedDeliveryDisconnectCallback(base::BindOnce(
+          [](CaptureToAtlasVideoFramePool* pool, bool* frozen) {
+            // Freeze precedes notification and the posted VideoFrame return.
+            EXPECT_FALSE(pool->ReserveVideoFrame(media::PIXEL_FORMAT_ARGB,
+                                                 gfx::Size(64, 48)));
+            *frozen = true;
+          }, base::Unretained(pool.get()), &frozen)));
+  mojo::Remote<mojom::FrameSinkVideoConsumerFrameCallbacks> callbacks;
+  mojo::MakeSelfOwnedReceiver(std::move(delivery),
+                              callbacks.BindNewPipeAndPassReceiver());
+  // Close the actual frame callback pipe without Done, independently of the
+  // capturer control pipe. Mojo destroys its self-owned delivery receiver.
+  callbacks.reset();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(frozen);
+  EXPECT_FALSE(
+      pool->ReserveVideoFrame(media::PIXEL_FORMAT_ARGB, gfx::Size(64, 48)));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(pool->GetNumberOfReservedFrames(), 0u);
+  EXPECT_FALSE(
+      pool->ReserveVideoFrame(media::PIXEL_FORMAT_ARGB, gfx::Size(64, 48)));
+  pool.reset();
+  EXPECT_TRUE(counts.context_destroyed);
+}
+
+TEST(CaptureToAtlasVideoFramePoolTest, ExplicitDoneDoesNotSealPool) {
+  base::SingleThreadTaskExecutor tasks;
+  Counts counts;
+  std::string reason;
+  auto pool = CaptureToAtlasVideoFramePool::Create(
+      4, gfx::Size(80, 64), gfx::Rect(4, 4, 64, 48), Handles(),
+      std::make_unique<FakeAtlasContext>(&counts), reason);
+  ASSERT_TRUE(pool) << reason;
+  auto frame =
+      pool->ReserveVideoFrame(media::PIXEL_FORMAT_ARGB, gfx::Size(64, 48));
+  ASSERT_TRUE(frame);
+  bool frozen = false;
+  auto delivery = std::make_unique<InFlightFrameDelivery>(
+      base::BindOnce([](scoped_refptr<media::VideoFrame>) {}, std::move(frame)),
+      base::OnceCallback<void(const media::VideoCaptureFeedback&)>(),
+      pool->MakeUnexpectedDeliveryDisconnectCallback(
+          base::BindOnce([](bool* frozen) { *frozen = true; }, &frozen)));
+  mojo::Remote<mojom::FrameSinkVideoConsumerFrameCallbacks> callbacks;
+  mojo::MakeSelfOwnedReceiver(std::move(delivery),
+                              callbacks.BindNewPipeAndPassReceiver());
+  callbacks->Done();
+  callbacks.FlushForTesting();
+  callbacks.reset();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(frozen);
+  auto next =
+      pool->ReserveVideoFrame(media::PIXEL_FORMAT_ARGB, gfx::Size(64, 48));
+  EXPECT_TRUE(next);
+  next.reset();
+  base::RunLoop().RunUntilIdle();
+  pool.reset();
+  EXPECT_TRUE(counts.context_destroyed);
+}
+
+TEST(CaptureToAtlasVideoFramePoolTest,
+     RejectsGeometryIdentityAndPartialImport) {
+  base::SingleThreadTaskExecutor tasks;
+  std::string reason;
+  Counts invalid;
+  EXPECT_FALSE(CaptureToAtlasVideoFramePool::Create(
+      0, gfx::Size(80, 64), gfx::Rect(4, 4, 64, 48), Handles(),
+      std::make_unique<FakeAtlasContext>(&invalid), reason));
+  EXPECT_EQ(invalid.imported, 0);
+  Counts geometry;
+  EXPECT_FALSE(CaptureToAtlasVideoFramePool::Create(
+      1, gfx::Size(80, 64), gfx::Rect(4, 4, 80, 64), Handles(),
+      std::make_unique<FakeAtlasContext>(&geometry), reason));
+  EXPECT_EQ(geometry.imported, 0);
+  Counts duplicate;
+  auto handles = Handles();
+  handles[1] = handles[0].Clone();
+  EXPECT_FALSE(CaptureToAtlasVideoFramePool::Create(
+      1, gfx::Size(80, 64), gfx::Rect(4, 4, 64, 48), std::move(handles),
+      std::make_unique<FakeAtlasContext>(&duplicate), reason));
+  EXPECT_EQ(duplicate.imported, 0);
+  Counts partial;
+  EXPECT_FALSE(CaptureToAtlasVideoFramePool::Create(
+      1, gfx::Size(80, 64), gfx::Rect(4, 4, 64, 48), Handles(),
+      std::make_unique<FakeAtlasContext>(&partial, 1), reason));
+  EXPECT_EQ(partial.imported, 1);
+  EXPECT_EQ(partial.destroyed, 1);
+  EXPECT_TRUE(partial.context_destroyed);
+}
+}  // namespace
+#endif
+}  // namespace viz

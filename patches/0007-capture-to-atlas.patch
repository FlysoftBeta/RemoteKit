+void FrameSinkVideoCapturerImpl::InvalidateCaptureToAtlas(
+    const std::string& reason,
+    bool reconfigure) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!capture_to_atlas_generation_ || capture_to_atlas_invalidated_) {
+    return;
+  }
+  capture_to_atlas_invalidated_ = true;
+  LOG(ERROR) << "RemoteKitCaptureToAtlas invalidated generation="
+             << capture_to_atlas_generation_ << " reason=" << reason;
+  Stop();
+  if (resolved_target_) {
+    resolved_target_->DetachCaptureClient(this);
+    resolved_target_ = nullptr;
+  }
+  if (frame_pool_) {
+    frame_pool_->InvalidateBuffers();
+  }
+  frame_pool_.reset();
+  if (receiver_.is_bound()) {
+    receiver_.ResetWithReason(reconfigure ? 1u : 0u, reason);
+    // Do not erase the owner entry while a target/manager notification is
+    // iterating it. The weak callback is canceled if shutdown destroys us.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            &FrameSinkVideoCapturerImpl::DeleteInvalidatedCaptureToAtlas,
+            capture_to_atlas_weak_factory_.GetWeakPtr()));
+  }
+}

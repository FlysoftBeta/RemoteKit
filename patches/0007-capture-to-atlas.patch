+struct Counts {
+  int imported = 0;
+  int destroyed = 0;
+  bool context_destroyed = false;
+};
+
+class FakeAtlasContext : public CaptureToAtlasVideoFramePool::Context {
+ public:
+  explicit FakeAtlasContext(Counts* counts, int fail_at = -1)
+      : counts_(counts), fail_at_(fail_at) {}
+  ~FakeAtlasContext() override { counts_->context_destroyed = true; }
+  scoped_refptr<gpu::ClientSharedImage> CreateSharedImage(
+      const gfx::Size&,
+      gfx::BufferUsage,
+      const SharedImageFormat&,
+      const gfx::ColorSpace&,
+      gpu::SharedImageUsageSet,
+      gpu::SyncToken&) override {
+    ADD_FAILURE() << "fixed pool must never allocate a destination";
+    return nullptr;
+  }
+  scoped_refptr<gpu::ClientSharedImage> ImportCaptureToAtlasImage(
+      const gfx::Size& size,
+      gfx::GpuMemoryBufferHandle,
+      gpu::SyncToken&) override {
+    if (counts_->imported == fail_at_) {
+      return nullptr;
+    }
+    ++counts_->imported;
+    gpu::SharedImageMetadata metadata;
+    metadata.format = SinglePlaneFormat::kBGRA_8888;
+    metadata.size = size;
+    metadata.color_space = gfx::ColorSpace::CreateSRGB();
+    // CPU shared memory provides a real mappable CSI without a GPU/device.
+    return gpu::ClientSharedImage::CreateForTesting(
+        gpu::Mailbox::Generate(), metadata, gpu::SyncToken(), false,
+        base::BindRepeating(
+            [](gpu::ClientSharedImage::AsyncMapCompletionCallback cb) {
+              std::move(cb).Run(true);
+            }),
+        gfx::BufferUsage::GPU_READ_CPU_READ_WRITE,
+        base::MakeRefCounted<gpu::SharedImageInterfaceHolder>(nullptr));
+  }
+  void DestroySharedImage(
+      const gpu::SyncToken&,
+      scoped_refptr<gpu::ClientSharedImage> image) override {
+    EXPECT_FALSE(counts_->context_destroyed);
+    EXPECT_TRUE(image);
+    ++counts_->destroyed;
+  }
+  const gpu::SharedImageCapabilities& GetCapabilities() override {
+    return capabilities_;
+  }
+
+ private:
+  raw_ptr<Counts> counts_;
+  int fail_at_;
+  gpu::SharedImageCapabilities capabilities_;
+};
+

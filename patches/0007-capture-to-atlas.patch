+#ifndef COMPONENTS_VIZ_SERVICE_FRAME_SINKS_VIDEO_CAPTURE_CAPTURE_TO_ATLAS_VIDEO_FRAME_POOL_H_
+#define COMPONENTS_VIZ_SERVICE_FRAME_SINKS_VIDEO_CAPTURE_CAPTURE_TO_ATLAS_VIDEO_FRAME_POOL_H_
+
+#include <stdint.h>
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "components/viz/service/frame_sinks/video_capture/video_frame_pool.h"
+#include "media/gfx/renderable_mappable_shared_image_video_frame_pool.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/gpu_memory_buffer_handle.h"
+
+namespace viz {
+
+// A single immutable generation of three externally supplied destinations.
+// Every outstanding VideoFrame keeps the context and all imported images alive,
+// independently of the pool/capturer lifetime. Final VideoFrame release must
+// occur on the capturer sequence (checked by the release callback).
+class VIZ_SERVICE_EXPORT CaptureToAtlasVideoFramePool : public VideoFramePool {
+ public:
+  using Context = media::RenderableMappableSharedImageVideoFramePool::Context;
+  static std::unique_ptr<CaptureToAtlasVideoFramePool> Create(
+      uint64_t generation,
+      const gfx::Size& atlas_size,
+      const gfx::Rect& visible_rect,
+      std::vector<gfx::GpuMemoryBufferHandle> buffers,
+      std::unique_ptr<Context> context,
+      std::string& reason);
+  ~CaptureToAtlasVideoFramePool() override;
+
+  scoped_refptr<media::VideoFrame> ReserveVideoFrame(
+      media::VideoPixelFormat format,
+      const gfx::Size& size) override;
+  media::mojom::VideoBufferHandlePtr CloneHandleForDelivery(
+      const media::VideoFrame& frame) override;
+  size_t GetNumberOfReservedFrames() const override;
+  void InvalidateBuffers() override;
+  // Holds this generation independently of the capturer. On unexpected frame
+  // pipe loss it seals all slots before releasing any captured VideoFrame.
+  base::OnceClosure MakeUnexpectedDeliveryDisconnectCallback(
+      base::OnceClosure invalidate_capturer);
+
+ private:
+  class Generation;
+  explicit CaptureToAtlasVideoFramePool(scoped_refptr<Generation> state);
+  scoped_refptr<Generation> state_;
+};
+
+}  // namespace viz
+
+#endif  // COMPONENTS_VIZ_SERVICE_FRAME_SINKS_VIDEO_CAPTURE_CAPTURE_TO_ATLAS_VIDEO_FRAME_POOL_H_

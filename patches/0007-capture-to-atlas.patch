+bool IsMappableRgbaBlit(const CopyOutputRequest& request) {
+  return request.result_format() == CopyOutputRequest::ResultFormat::RGBA &&
+         request.has_blit_request() &&
+         request.blit_request().populates_mappable_shared_image();
+}
+
+void LogMappableRgbaBlitFailure(const CopyOutputRequest& request,
+                                const copy_output::RenderPassGeometry& geometry,
+                                std::string_view stage,
+                                const SkiaOutputSurfaceImplOnGpu& impl,
+                                std::string_view detail = {}) {
+  if (!IsMappableRgbaBlit(request)) {
+    return;
+  }
+  const auto& blit = request.blit_request();
+  LOG(ERROR) << "RemoteKitCaptureToAtlas Skia failure request_id="
+             << reinterpret_cast<uint64_t>(&request) << " stage=" << stage
+             << " requested_selection="
+             << (request.has_result_selection()
+                     ? request.result_selection().ToString()
+                     : "unset")
+             << " actual_selection=" << geometry.result_selection.ToString()
+             << " sampling_bounds=" << geometry.sampling_bounds.ToString()
+             << " destination_offset="
+             << blit.destination_region_offset().ToString() << " mailbox="
+             << (blit.shared_image()
+                     ? blit.shared_image()->mailbox().ToDebugString()
+                     : "null")
+             << " impl_state=" << impl.CopyOutputCompletionStateForLogging()
+             << " detail=" << detail;
+}

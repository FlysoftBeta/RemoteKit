+  EXPECT_FALSE(CaptureToAtlasVideoFramePool::Create(
+      1, gfx::Size(80, 64), gfx::Rect(4, 4, 80, 64), Handles(),
+      std::make_unique<FakeAtlasContext>(&geometry), reason));
+  EXPECT_EQ(geometry.imported, 0);
+  Counts duplicate;
+  auto handles = Handles();

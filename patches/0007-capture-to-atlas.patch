+  EXPECT_FALSE(CaptureToAtlasVideoFramePool::Create(
+      1, gfx::Size(80, 64), gfx::Rect(4, 4, 64, 48), std::move(handles),
+      std::make_unique<FakeAtlasContext>(&duplicate), reason));
+  EXPECT_EQ(duplicate.imported, 0);
+  Counts partial;
+  EXPECT_FALSE(CaptureToAtlasVideoFramePool::Create(
+      1, gfx::Size(80, 64), gfx::Rect(4, 4, 64, 48), Handles(),
+      std::make_unique<FakeAtlasContext>(&partial, 1), reason));
+  EXPECT_EQ(partial.imported, 1);
+  EXPECT_EQ(partial.destroyed, 1);
+  EXPECT_TRUE(partial.context_destroyed);
+}
